<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The hardened runtime is a requirement for notarization, and these three are
    what an Electron app needs back out of it. V8 compiles JavaScript at run
    time, which the hardened runtime forbids by default, and the Steamworks
    native module is signed by us rather than by Apple's library validation.
    Without them the app is notarized and then refuses to start.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
